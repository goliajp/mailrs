<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug — what an app installed from Xcode is signed for. The
	     Release configuration points at Mailrs.release.entitlements
	     instead, so nothing has to be remembered on the way to
	     TestFlight.

	     Hand-written, deliberately. This file used to be generated by
	     XcodeGen's `entitlements:` key, which regenerates it on every
	     build — and a `path` with no `properties` generates an empty
	     dict. `aps-environment` vanished on each build, the app
	     installed and ran, and no notification ever arrived. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
