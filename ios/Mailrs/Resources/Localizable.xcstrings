    "An alias delivers one address to another.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エイリアスは、あるアドレスを別のアドレスへ配送します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别名把一个地址投递到另一个地址。"
          }
        }
      }
    },
