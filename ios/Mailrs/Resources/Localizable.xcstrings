{
  "sourceLanguage": "en",
  "strings": {
    "%@ stops working immediately.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は直ちに使えなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将立即失效。"
          }
        }
      }
    },
    "%@ — its members keep their own mailboxes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — メンバー自身のメールボックスはそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ —— 成员各自的邮箱不受影响。"
          }
        }
      }
    },
    "%@ — its members lose every permission it granted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — メンバーはこのグループが与えていた権限をすべて失います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ —— 其成员将失去这个组授予的全部权限。"
          }
        }
      }
    },
    "%@ — mail to every address on it will stop being accepted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — このドメインのすべてのアドレス宛のメールは受信されなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ —— 该域名下所有地址的邮件都将不再被接收。"
          }
        }
      }
    },
    "%lld attempts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已尝试 %lld 次"
          }
        }
      }
    },
    "%lld messages": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のメール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 封邮件"
          }
        }
      }
    },
    "%lld of %lld messages aligned": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld 通がアライメント成功"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld 封邮件通过对齐"
          }
        }
      }
    },
    "%lld reports": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のレポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 份报告"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件を選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 项"
          }
        }
      }
    },
    "(no recipient)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(宛先なし)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(无收件人)"
          }
        }
      }
    },
    "(no subject)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(件名なし)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(无主题)"
          }
        }
      }
    },
    "(unknown)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(不明)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(未知)"
          }
        }
      }
    },
    "1 message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 件のメール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 封邮件"
          }
        }
      }
    },
    "A domain has to be listed here before mail to it is accepted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに登録して初めて、そのドメイン宛のメールを受け取ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "域名必须先列在这里,发往它的邮件才会被接收。"
          }
        }
      }
    },
    "A group delivers one address to several people.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは、1 つのアドレスを複数の人に配送します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件组把一个地址投递给多个人。"
          }
        }
      }
    },
    "A group grants its members the permissions you tick.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは、チェックした権限をメンバーに与えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组把你勾选的权限授予它的成员。"
          }
        }
      }
    },
    "A key lets a program read and send mail as you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはプログラムがあなたとしてメールを読み書きすることを許可します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥让程序以你的身份读取和发送邮件。"
          }
        }
      }
    },
    "A message you close without sending is kept here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信せずに閉じたメールはここに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭而未发送的邮件会留在这里。"
          }
        }
      }
    },
    "API keys": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Accounts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Accounts are the mailboxes this server hosts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは、このサーバーが持つメールボックスです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户就是这台服务器托管的邮箱。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add Cc and Bcc": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cc と Bcc を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加抄送与密送"
          }
        }
      }
    },
    "Add account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加账户"
          }
        }
      }
    },
    "Add address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加地址"
          }
        }
      }
    },
    "Add alias": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エイリアスを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加别名"
          }
        }
      }
    },
    "Add domain": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加域名"
          }
        }
      }
    },
    "Add group": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建群组"
          }
        }
      }
    },
    "Add member": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加成员"
          }
        }
      }
    },
    "Added to mail sent from this account, above any quoted text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントから送信するメールに、引用文の上に追加されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将添加到此账号发出的邮件中，位于引用内容之上。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Addresses the sender will not try again until cleared.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除するまで、送信側はこれらのアドレスに再送しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在清除之前，发送器不会再向这些地址投递。"
          }
        }
      }
    },
    "Administrative changes appear here as they happen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理操作は、行われるたびにここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理操作发生时会即时出现在这里。"
          }
        }
      }
    },
    "Alias": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エイリアス"
          }
        },
        "zh-Hans": {
