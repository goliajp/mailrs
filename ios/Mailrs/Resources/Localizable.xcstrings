    "Asked for when the app starts, and when you come back to it after a minute away.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの起動時と、1 分以上離れてから戻ったときに確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动应用时，以及离开一分钟以上再回来时会要求验证。"
          }
        }
      }
    },
    "Attach": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付"
          }
        },
        "zh-Hans": {
