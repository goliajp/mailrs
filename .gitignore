# dhat-rs mem profiler dumps (regenerated by `cargo run --example dhat_profile`)
dhat-heap.json

# TMPDIR override created when invoking release.sh through the Claude harness
# (workspace-local TMPDIR avoids the macOS sandbox blocking tesseract from
# reading /tmp/claude-501/). Always deleted post-release; ignored as belt+braces.
.tmp-release/
.smix/

# Per-arm output of scripts/bench-api-e2e.sh, reduced by `--compare`. The
# numbers that survive go into PERFORMANCE.md with their reproduce command;
# these are the raw samples behind them, and they are machine-specific.
bench-results/

# py_compile leaves these beside the gate scripts.
__pycache__/

# The certificate authority the debug build is told to trust so a test
# can reach a mail server over real TLS. Generated per run by
# `ios/Testing/make-test-ca.sh`; a private key in a repository is a
# private key in a repository, however throwaway.
android/app/src/debug/res/raw/mailrs_test_ca.pem
