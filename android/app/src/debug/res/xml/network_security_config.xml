<?xml version="1.0" encoding="utf-8"?>
<!--
  The debug build's version of the main config, plus one thing.

  This file **replaces** `src/main/res/xml/network_security_config.xml`
  for debuggable builds only — a same-named resource in the `debug`
  source set wins — so everything below the `debug-overrides` block is
  a copy of it and must stay in step.

  The addition is `debug-overrides`, which trusts a certificate
  authority generated for the test run. It exists so a test can reach a
  mail server over **real TLS**: every other IMAP and SMTP assertion in
  this repo is made against a scripted transport, which has no
  handshake, no certificate, and no socket. On iOS the equivalent gap
  hid a real defect — a refused handshake left the client waiting
  forever instead of failing — and that is not the kind of thing a fake
  can be made to do.

  **`debug-overrides` is inert in a release build.** The platform
  ignores it unless the application is debuggable, so a shipped app
  trusts the system store and nothing else. This is the sanctioned way
  to do it; the alternative — an app that accepts any certificate under
  a flag — is the thing that ships by accident.

  The certificate is generated per run by `ios/Testing/make-test-ca.sh`
  and is not in git: a private key in a repository is a private key in
  a repository, however throwaway.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/mailrs_test_ca" />
        </trust-anchors>
    </debug-overrides>

    <!-- Copied from main; see the note above. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
