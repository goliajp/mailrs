<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Themed icon. From Android 13 the launcher tints this layer to the
      wallpaper when a person turns themed icons on, and an app without
      one is left as the single coloured square on the home screen. Same
      artwork as the foreground: the mark reads as a silhouette, which
      is the requirement.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
