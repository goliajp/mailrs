<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider is allowed to hand out.

  Only the attachments directory, not the whole cache: a provider that
  shares `.` shares every file this app has written, and the grant is
  by URI so a bug in what URI gets built becomes a bug in what leaves.
-->
<paths>
    <cache-path name="attachments" path="attachments/" />
</paths>
