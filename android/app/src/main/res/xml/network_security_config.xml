<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext to the emulator's host, and nowhere else.

  Android has refused cleartext HTTP by default since 9, which is right:
  a mail client's traffic carries a password and every message. The
  first instrumented run failed as "the inbox never listed" with an
  empty stub log — the requests were never sent, and nothing said so.

  The exceptions are loopback and `10.0.2.2` — the two ways the
  instrumented suite reaches `ios/Testing/stub-api.py`. The suite now
  goes through `adb reverse`, which makes the stub a guest-local port,
  because crossing the emulator's NAT stalls a connect every so often.
  `localhost` and `127.0.0.1` are separate entries: the matcher is
  literal, and naming one does not cover the other — which cost a run
  of 70 failures, all of them "Cleartext HTTP traffic to 127.0.0.1 not
  permitted".

  None of these can exist as a real mail host, so this cannot widen
  anything in a shipped build; production is https and stays that way.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
