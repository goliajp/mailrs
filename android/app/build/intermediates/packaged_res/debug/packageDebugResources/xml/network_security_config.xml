<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext to the emulator's host, and nowhere else.

  Android has refused cleartext HTTP by default since 9, which is right:
  a mail client's traffic carries a password and every message. The
  first instrumented run failed as "the inbox never listed" with an
  empty stub log — the requests were never sent, and nothing said so.

  The exception is exactly `10.0.2.2`, the emulator's route to the
  machine running `ios/Testing/stub-api.py`. It is an address that
  cannot exist on a real phone, so this cannot widen anything in a
  shipped build; production is https and stays that way.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
