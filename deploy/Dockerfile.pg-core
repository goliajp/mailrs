# The SQL core — fastcore's peer, on either SQL backend.
#
# FEATURES picks which:
#   core-rpc,spg   spg-embedded, no database container (the default, and what
#                  the reactivated lane runs)
#   core-rpc       real PostgreSQL via sqlx, needs a postgres service
#
# Both are the same code over the same `PgMailboxStore`; sqlx is the seam.
# Build one with:
#   ./scripts/build-pg-core.sh [--features core-rpc] [--push]
#
# Reuses cargo-chef so external deps are cached; only the workspace recompiles
# when the feature set changes.

FROM rust:1-trixie AS chef
RUN cargo install cargo-chef --locked --version ^0.1
WORKDIR /build

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS rust-builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
ARG FEATURES=core-rpc,spg
# `mailrs-pg-core`, not `mailrs-server`.
#
# Same boot sequence either way — the difference is the role set. `run()` turns
# every role on, which is what made that binary "the monolith" and is what
# `.claude/rfcs/20260722-monolith-out-of-image.md` ruled out. `mailrs-pg-core`
# selects: the core-api contract, the spool drain that indexes arrivals, and
# IMAP / POP3 / ManageSieve, and leaves SMTP, the web tier, outbound delivery
# and the RBL monitor to the processes that own them.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --release --bin mailrs-pg-core --features "$FEATURES" \
    && cargo build --release -p mailrs-core-sync \
    && cp /build/target/release/mailrs-pg-core /usr/local/bin/mailrs-pg-core \
    && cp /build/target/release/mailrs-core-sync /usr/local/bin/mailrs-core-sync

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-builder /usr/local/bin/mailrs-pg-core /usr/local/bin/mailrs-pg-core
COPY --from=rust-builder /usr/local/bin/mailrs-core-sync /usr/local/bin/mailrs-core-sync
# mailrs-core-sync rides along on purpose: the switch this image exists for is
# "bring the other core up, sync, flip MAILRS_CORE_RPC_BASE", and the sync has
# to be runnable from beside the core it is syncing.
ENTRYPOINT ["mailrs-pg-core"]
