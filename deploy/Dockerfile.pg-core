# PG-core variant: mailrs-server WITHOUT the spg feature, so
# BackendPool = sqlx::PgPool (real PostgreSQL). Used ONLY for the v2
# two-mode staging validation — the main image ships the spg build.
# Reuses cargo-chef so external deps are cached; only the workspace
# recompiles for the non-spg feature set.

FROM rust:1-trixie AS chef
RUN cargo install cargo-chef --locked --version ^0.1
WORKDIR /build

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS rust-builder
COPY --from=planner /build/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo chef cook --release --recipe-path recipe.json
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
# non-spg: real PostgreSQL backend + the core-api surface, and nothing else.
#
# `mailrs-pg-core`, not `mailrs-server --features core-rpc`. This used to build
# the whole monolith and rename it — which starts SMTP, IMAP, POP3,
# ManageSieve, CalDAV, ACME and the web tier alongside the RPC server, all of
# which have their own processes in this topology. Reviving the fat process is
# what `.claude/rfcs/20260722-monolith-out-of-image.md` explicitly ruled out;
# the thin binary is the shape it asked for.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    cargo build --release --bin mailrs-pg-core --features core-rpc \
    && cargo build --release -p mailrs-core-sync \
    && cp /build/target/release/mailrs-pg-core /usr/local/bin/mailrs-pg-core \
    && cp /build/target/release/mailrs-core-sync /usr/local/bin/mailrs-core-sync

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-builder /usr/local/bin/mailrs-pg-core /usr/local/bin/mailrs-pg-core
COPY --from=rust-builder /usr/local/bin/mailrs-core-sync /usr/local/bin/mailrs-core-sync
# mailrs-core-sync rides along on purpose: the switch this image exists for is
# "bring the other core up, sync, flip MAILRS_CORE_RPC_BASE", and the sync has
# to be runnable from beside the core it is syncing.
ENTRYPOINT ["mailrs-pg-core"]
